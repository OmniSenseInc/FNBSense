# Dependencies
node_modules/
vendor/

# Environment
.env
.env.*.local
*.env.local

# Kredensial produksi. Pola `.env` di atas TIDAK mencakupnya — ia cuma cocok
# untuk nama yang persis ".env", dan `.env.*.local` menuntut akhiran .local.
# Tanpa baris ini, sandi MySQL dan RabbitMQ produksi ikut ter-commit.
.env.production

# Kunci JWT produksi. Private key di sini yang menerbitkan SELURUH token; siapa
# pun yang memegangnya bisa membuat dirinya owner di kafe mana pun.
infra/keys/*
!infra/keys/.gitkeep

# Laravel
/services/*/storage/*.key
/services/*/storage/logs/*
/services/*/storage/framework/cache/*
/services/*/storage/framework/sessions/*
/services/*/storage/framework/views/*
/services/*/bootstrap/cache/*.php
/services/*/public/storage

# Build / cache
dist/
build/
.cache/
*.log

# Docker
docker-data/

# Python (Hermes)
__pycache__/
*.pyc
.venv/
venv/

# Claude Code (setting lokal, tidak di-commit)
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Skrip ad-hoc operator. Sengaja TIDAK pernah tracked: isinya sering memuat
# token/kredensial dev sekali pakai. Skrip yang layak disimpan -> pindahkan ke docs/.
scratchpad/

# Kunci privat JWT service — jangan pernah ikut commit (fatal kalau bocor).
**/*.pem
