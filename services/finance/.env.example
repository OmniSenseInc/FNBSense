APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT (php-open-source-saver/jwt-auth) — auth lintas-service RS256.
# Finance HANYA memverifikasi tanda tangan token terbitan IAM; tak pernah menerbitkan.
# Copy jwt-public.pem dari service IAM ke storage/keys/ (berkas .pem gitignored).
# JWT_PRIVATE_KEY diarahkan ke PUBLIC key yang SAMA (bukan private IAM): lcobucci
# menolak private key kosong walau cuma verify, jadi slot wajib terisi. Public aman
# karena tak bisa menandatangani token.
# Path RELATIF terhadap root service — diabsolutkan di config/jwt.php.
JWT_SECRET=
JWT_ALGO=RS256
JWT_PRIVATE_KEY=file://storage/keys/jwt-public.pem
JWT_PUBLIC_KEY=file://storage/keys/jwt-public.pem
JWT_PASSPHRASE=
JWT_BLACKLIST_ENABLED=false
# RabbitMQ — consumer order.paid (F5b). Topologi & kredensial WAJIB identik dgn
# Ordering (exchange fnbsense.events dipakai bersama).
# CATATAN: broker dev FNBSense jalan di WSL2 & di-relay hanya ke ::1 (IPv6
# loopback), bukan 127.0.0.1. Pakai HOST=localhost supaya PHP bisa resolve ke ::1;
# 127.0.0.1 (IPv4) akan "connection refused".
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=fnbsense
# Samakan dengan RABBITMQ_DEFAULT_PASS di .env root. JANGAN tulis nilai asli di sini
RABBITMQ_PASSWORD=change_me_in_dev
RABBITMQ_VHOST=/
