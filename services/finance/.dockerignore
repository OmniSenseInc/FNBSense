# Build context image ini = folder service ini (lihat infra/php/Dockerfile).
#
# vendor/ sengaja tak ikut: ia diinstal ulang di dalam image dengan --no-dev.
# Menyalin vendor hasil `composer install` di Windows ke image Linux berarti
# menjalankan hasil resolusi mesin lain, dan bedanya baru terlihat saat runtime.
vendor/
node_modules/

# .env juga dihapus lagi di dalam Dockerfile — dua pagar untuk hal yang sama,
# karena satu berkas terlewat di sini berarti kredensial dev ikut ke produksi.
.env
.env.*

storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

# Cache bootstrap hasil generate di mesin pengembang. WAJIB dikecualikan.
#
# packages.php dan services.php memuat daftar service provider yang ditemukan
# saat `composer install` dijalankan DENGAN dependensi dev. Image dibangun
# --no-dev, jadi provider seperti Collision tak ada di sana — tapi cache yang
# ikut tersalin tetap menyebutnya, dan `package:discover` mati dengan
# "Class NunoMaduro\Collision\...\CollisionServiceProvider not found".
#
# Notification yang pertama kena. Empat service lain cuma belum kena karena
# cache mereka kebetulan belum memuat provider dev — bukan karena aman.
bootstrap/cache/*.php
.phpunit.result.cache
.git/
