# Koneksi RabbitMQ — samakan dengan docker-compose.yml root.
# Password JANGAN diisi di file example; salin ke .env lalu isi di sana.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=fnbsense
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/

# Server WebSocket KDS (F3b)
WS_PORT=8081
# Public key IAM (RS256). Default: path relatif ke public key Ordering (lintas-OS).
# JWT_PUBLIC_KEY_PATH=../ordering/storage/keys/jwt-public.pem
