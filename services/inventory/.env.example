APP_NAME="FNBSense Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fnbsense_inventory
DB_USERNAME=root
DB_PASSWORD=

# Stateless: identitas datang dari JWT per-request, bukan cookie session.
# Tabel `sessions` sengaja tidak ada di service ini.
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# JWT (php-open-source-saver/jwt-auth) — auth lintas-service RS256 (CRUD stok owner-only).
# Inventory HANYA memverifikasi tanda tangan token pakai PUBLIC key IAM:
# tidak menerbitkan token, tidak punya tabel users, tidak query IAM.
# Copy jwt-public.pem dari service IAM ke storage/keys/ (lihat README).
# JWT_PRIVATE_KEY diarahkan ke PUBLIC key yang SAMA, bukan private key IAM.
# lcobucci menolak private key kosong ("Key cannot be empty") walau service ini
# cuma verify, jadi slot wajib terisi. Isi dengan PUBLIC key: kunci publik tak
# bisa menandatangani, jadi service ini tetap TIDAK BISA memalsukan token IAM.
# JANGAN pernah taruh private key IAM asli di sini.
JWT_SECRET=
JWT_ALGO=RS256
JWT_PRIVATE_KEY=file://storage/keys/jwt-public.pem
JWT_PUBLIC_KEY=file://storage/keys/jwt-public.pem
JWT_PASSPHRASE=
JWT_BLACKLIST_ENABLED=false

# Service Catalog (opsi C: panggil langsung ke port service, bukan via gateway).
# Consumer query resep (BOM) ke Catalog saat potong stok. Consumer jalan dari
# event, tak punya user JWT → auth pakai shared-secret header X-Service-Token.
# CATALOG_SERVICE_TOKEN HARUS sama persis dengan yang di-set di service Catalog.
CATALOG_BASE_URL=http://127.0.0.1:8001
CATALOG_TIMEOUT=3
CATALOG_SERVICE_TOKEN=

# Secret yang DITERIMA Inventory di POST /api/availability (gerbang stok yang
# ditanyakan Ordering sebelum order dibuat). Harus sama persis dengan
# INVENTORY_SERVICE_TOKEN di services/ordering/.env.
#
# Sengaja BEDA dari CATALOG_SERVICE_TOKEN di atas: yang itu dikirim KELUAR ke
# Catalog. Memakai satu nilai untuk dua arah berarti token yang bocor dari satu
# sisi ikut membuka sisi yang lain.
INVENTORY_SERVICE_TOKEN=

# RabbitMQ — consumer order.paid (F4b). Host/kredensial HARUS sama dengan Ordering
# supaya nyambung ke exchange fnbsense.events (topic) yang sama.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=fnbsense
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
