{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fnbsense/reporting",
    "type": "project",
    "description": "FNBSense event-driven reporting read model.",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "php-amqplib/php-amqplib": "^3.7"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php artisan test"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
