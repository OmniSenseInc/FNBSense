# Path relatif, BUKAN URL penuh: dev server meneruskannya ke Laravel lewat
# proxy di vite.config.ts. Awalannya harus cocok dengan kunci proxy di sana.
VITE_IAM_URL=/iam
VITE_ORDERING_URL=/ordering
VITE_NOTIFICATION_URL=/notification

# Alamat app PELANGGAN — satu-satunya nilai di berkas ini yang WAJIB URL penuh,
# bukan path relatif. Isinya berakhir di dalam QR yang dicetak dan ditempel di
# meja, jadi yang membukanya adalah HP orang lain: "localhost" di situ menunjuk
# ke HP-nya sendiri, dan QR-nya mati di tangan pelanggan pertama.
#
# Untuk mencoba dari HP di Wi-Fi yang sama, isi dengan alamat IP laptop ini
# (mis. http://192.168.1.5:5173). Untuk produksi, domain app pelanggan.
VITE_CUSTOMER_URL=http://localhost:5173
