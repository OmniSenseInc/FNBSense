# Salin ke .env.local lalu sesuaikan. .env.local sudah diabaikan git (*.local).
#
# PERINGATAN: semua VITE_* ikut TERBUNGKUS ke dalam bundle JavaScript yang
# dikirim ke HP pelanggan dan bisa dibaca siapa pun lewat "view source".
# Hanya nilai publik di sini — JANGAN PERNAH token, password, atau kunci.

# Path relatif, BUKAN URL penuh: dev server meneruskannya ke Laravel lewat
# proxy di vite.config.ts. Awalannya harus cocok dengan kunci proxy di sana.
#
# Kenapa bukan http://localhost:8000 — app ini dibuka dari HP pelanggan, dan
# "localhost" di HP berarti HP itu sendiri. Menu tak akan pernah termuat.
# Backend juga sengaja tak dipaparkan ke Wi-Fi: HP cuma bicara ke port Vite.
VITE_ORDERING_URL=/ordering
VITE_CATALOG_URL=/catalog

VITE_NAMA_KAFE=Kafe Contoh
