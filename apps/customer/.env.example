# Salin ke .env.local lalu sesuaikan. .env.local sudah diabaikan git (*.local).
#
# PERINGATAN: semua VITE_* ikut TERBUNGKUS ke dalam bundle JavaScript yang
# dikirim ke HP pelanggan dan bisa dibaca siapa pun lewat "view source".
# Hanya nilai publik di sini — JANGAN PERNAH token, password, atau kunci.

VITE_ORDERING_URL=http://localhost:8000
VITE_CATALOG_URL=http://localhost:8001
VITE_NAMA_KAFE=Kafe Contoh
